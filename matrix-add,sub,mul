class matrix:
    def __init__(self,mat,r,c):
        self.mat=mat
        self.r=r
        self.c=c
    def __add__(self,var):
        r=[[0]*var.c for i in range(var.r)]
        if self.r==var.r and self.c==var.c:
            for i in range(self.r):
                for j in range(self.c):
                    r[i][j]=self.mat[i][j]+var.mat[i][j]
            for i in r:
                print(i)
        else:
            print("Addition not possible")
    def __sub__(self,var):
        r=[[0]*var.c for i in range(var.r)]
        if self.r==var.r and self.c==var.c:
            for i in range(self.r):
                for j in range(self.c):
                    r[i][j]=self.mat[i][j]-var.mat[i][j]
            for i in r:
                print(i)
        else:
            print("Subtraction not possible")
    def __mul__(self,var):
        if self.c!=var.r:
            print("Multiplication not possible")
        else:
            r=[[0]*var.c for _ in range(self.r)]
            for i in range(self.r):
                for j in range(var.c):
                    for k in range(self.c):
                        r[i][j]+=self.mat[i][k]*var.mat[k][j]
            for i in r:
                print(i)
